@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FileStorageService Storage
@inject CompletionService Completion
@inject UserService UserSvc
@inject AuditLogger Audit
@inject NavigationManager Nav

<PageTitle>Ввод показателей</PageTitle>

@* .sheet-page — колонка на всю высоту рабочей области: прокручивается только таблица *@
<div class="sheet-page">

<h1>Индивидуальные показатели работы преподавателя</h1>

@if (busy)
{
    <div class="busy-overlay">
        <div class="busy-card">
            <div class="spinner"></div>
            <span>@busyText</span>
        </div>
    </div>
}

<div class="toolbar">
    <div class="field field-teacher">
        <label>Преподаватель</label>
        @if (!loaded)
        {
            @* до загрузки прав неизвестно, админ это или нет — держим место, чтобы тулбар не «прыгал» *@
            <div class="control control-static skeleton"></div>
        }
        else if (isAdmin)
        {
            <select class="control" value="@selectedTeacherId" @onchange="OnTeacherChanged">
                <option value="0">— выберите —</option>
                @foreach (var d in departments)
                {
                    <optgroup label="@d.Name">
                        @foreach (var t in teachers.Where(t => t.DepartmentId == d.Id))
                        {
                            <option value="@t.Id">@t.FullName</option>
                        }
                    </optgroup>
                }
            </select>
        }
        else
        {
            <div class="control control-static" title="@myDepartmentName">@TeacherName()</div>
        }
    </div>

    <div class="field field-year">
        <label>Учебный год</label>
        <select class="control" value="@academicYear" @onchange="OnPeriodChanged">
            @foreach (var y in years)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>

    <div class="field field-sem">
        <label>Семестр</label>
        <select class="control" value="@semester" @onchange="OnSemesterChanged">
            @foreach (var s in Periods.Semesters)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>

    <div class="field grow">
        <label>&nbsp;</label>
        <div class="row toolbar-actions">
            <span class="save-msg">@saveMessage</span>
            @if (loaded && selectedTeacherId != 0 && !isCompleted)
            {
                <span class="complete-hint" title="Пока отметка не поставлена, преподаватель считается незаполнившим показатели за период">
                    Заполнили таблицу — обязательно нажмите
                    <span class="complete-arrow" aria-hidden="true">→</span>
                </span>
            }
            <button class="btn btn-complete @(isCompleted ? "success" : "")" disabled="@(!loaded || selectedTeacherId == 0)"
                    @onclick="ToggleCompleted"
                    title="@(isCompleted
                              ? "Отметка снимется — таблица снова будет считаться незаполненной"
                              : "Нажмите, когда внесли все показатели за период: преподаватель отметится как заполнивший, и его данные попадут в отчёт кафедры")">
                @(isCompleted ? "✓ Заполнено" : "Заполнено")
            </button>
            <button class="btn primary" @onclick="GoToReport">Перейти к отчётам →</button>
        </div>
    </div>
</div>

@if (showClearConfirm)
{
    <div class="modal-backdrop" @onclick="() => showClearConfirm = false">
        <div class="modal" @onclick:stopPropagation>
            <h3>@(pendingClearSection is null ? "Очистить всю таблицу?" : "Очистить раздел?")</h3>
            <p>
                @if (pendingClearSection is WorkSection sec)
                {
                    <text>Будут удалены все баллы, комментарии и файлы раздела «@sec.Title()» преподавателя <strong>@TeacherName()</strong> за выбранный период.</text>
                }
                else
                {
                    <text>Будут удалены все баллы, комментарии и файлы преподавателя <strong>@TeacherName()</strong> за выбранный период (все разделы).</text>
                }
            </p>
            <p class="hint">Действие необратимо.</p>
            <div class="modal-actions">
                <button class="btn" @onclick="() => showClearConfirm = false">Отмена</button>
                <button class="btn danger" @onclick="DoClear">Очистить</button>
            </div>
        </div>
    </div>
}

@if (commentRow != null)
{
    <div class="modal-backdrop" @onclick="CloseComment">
        <div class="modal wide comment-modal" @onclick:stopPropagation>
            <h3>Комментарий — п. @commentRow.Wt.FullNumber</h3>
            <div class="comment-modal-subtitle">@commentRow.Wt.Title</div>
            <textarea class="control comment-editor" rows="14" maxlength="2000"
                      @ref="commentEditor"
                      @bind="commentDraft" @bind:event="oninput"
                      @onkeydown="OnCommentKeyDown"
                      placeholder="Перечислите работы: по одной в строке."></textarea>
            <div class="comment-modal-foot">
                @if (commentRow.Value == 0)
                {
                    <span class="comment-warn">Комментарий сохранится только вместе с баллом в колонке «Заполнение».</span>
                }
                <span class="comment-counter @(commentDraft.Length > 1900 ? "near-limit" : "")">
                    @commentDraft.Length / 2000
                </span>
            </div>
            <div class="modal-actions">
                <span class="comment-keyhint">Ctrl+Enter — сохранить, Esc — закрыть</span>
                <button class="btn" @onclick="CloseComment">Отмена</button>
                <button class="btn primary" @onclick="SaveComment">Сохранить</button>
            </div>
        </div>
    </div>
}

@if (infoText != null)
{
    <div class="modal-backdrop" @onclick="() => infoText = null">
        <div class="modal" @onclick:stopPropagation>
            <h3>@infoTitle</h3>
            @if (infoScores.Count > 0)
            {
                <div class="score-legend">
                    <div class="score-legend-title">Сколько баллов за что</div>
                    <table class="score-table">
                        @foreach (var s in infoScores)
                        {
                            <tr>
                                <td>@s.Label</td>
                                <td class="num">@s.Points.ToString("0.##")</td>
                            </tr>
                        }
                    </table>
                </div>
            }
            <div class="instr-text">@infoText</div>
            <div class="modal-actions">
                <button class="btn primary" @onclick="() => infoText = null">Понятно</button>
            </div>
        </div>
    </div>
}

@if (!loaded)
{
    @* пока права и справочники не загружены, ничего не утверждаем — иначе на долю секунды
       показывается чужое состояние (пустой список, сообщение о непривязанной учётке) *@
    <p class="hint loading-line"><span class="spinner small"></span> Загрузка…</p>
}
else if (!isAdmin && myTeacherId is null)
{
    <div class="hint-box">
        Учётная запись не привязана к преподавателю, поэтому вносить показатели нельзя.
        Обратитесь к администратору — привязка настраивается на вкладке «Пользователи».
    </div>
}
else if (selectedTeacherId == 0)
{
    <p class="hint">Выберите преподавателя, чтобы заполнить показатели за выбранный период.</p>
}
else
{
    <div class="totals-bar">
        @foreach (var sec in Enum.GetValues<WorkSection>())
        {
            var raw = SectionRaw(sec);
            var capped = ScoringRules.CapSection(raw);
            var over = capped != raw;
            <div class="total-chip @(over ? "capped" : "")" title="@sec.Title()">
                <span class="sec-num">Раздел @((int)sec)</span>
                <span class="sec-val">
                    @(over ? $"{raw:0.##} / {capped:0.##}" : capped.ToString("0.##"))
                    @if (over)
                    {
                        <button type="button" class="info-btn"
                                @onclick="() => ShowSectionLimit(raw, capped)">?</button>
                    }
                </span>
            </div>
        }
        @{
            var rawTotal = RawGrandTotal();
            var total = ScoringRules.CapTotal(rawTotal);
            var overTotal = rawTotal != total;
        }
        <div class="total-chip grand @(overTotal ? "capped" : "")">
            <span class="sec-num">ИТОГО</span>
            <span class="sec-val">
                @(overTotal ? $"{rawTotal:0.##} / {total:0.##}" : total.ToString("0.##"))
                @if (overTotal)
                {
                    <button type="button" class="info-btn"
                            @onclick="() => ShowTotalLimit(rawTotal, total)">?</button>
                }
            </span>
        </div>
        <button class="btn danger clear-all" @onclick="ConfirmClearAll"
                title="Удалить все баллы преподавателя за выбранный период">Очистить таблицу</button>
    </div>

    <div class="sheet-scroll">
    <table class="grid sheet">
        <thead>
            <tr>
                <th style="width:54px">№</th>
                <th>Вид работы</th>
                <th style="width:90px">Баллы</th>
                <th style="width:130px">Заполнение</th>
                <th style="width:70px">Балл</th>
                <th class="col-comment">Комментарий</th>
                <th style="width:180px">Файл</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sec in Enum.GetValues<WorkSection>())
            {
                var secRows = rows.Where(r => r.Wt.Section == sec).ToList();
                if (secRows.Count == 0) { continue; }
                var raw = SectionRaw(sec);
                var capped = ScoringRules.CapSection(raw);
                <tr class="section-row">
                    <td colspan="4">
                        <span class="sec-title-text">@sec.FullTitle()</span>
                        <button class="btn small danger clear-sec" @onclick="() => ConfirmClearSection(sec)"
                                title="Очистить этот раздел">Очистить раздел</button>
                    </td>
                    <td class="num">@capped.ToString("0.##")@(capped != raw ? $" / {raw:0.##}" : "")</td>
                    <td colspan="2"></td>
                </tr>
                @foreach (var row in secRows)
                {
                    @if (row.Wt.IsHeader)
                    {
                        @* строка-заголовок группы подпунктов: баллы вносятся по вложенным строкам *@
                        <tr class="group-row">
                            <td>@(row.Wt.ShowNumber ? row.Wt.Number : "")</td>
                            <td class="wt-cell" colspan="6">
                                <div class="wt-title lvl-@row.Wt.Level">
                                    @if (WorkInstructions.For(row.Wt.FullNumber) is string ginstr)
                                    {
                                        <button type="button" class="info-btn" title="Как заполнять"
                                                @onclick="() => OpenInfo(row.Wt, ginstr)">?</button>
                                    }
                                    <span>@row.Wt.Title</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                    <tr>
                        <td>@(row.Wt.ShowNumber ? row.Wt.Number : "")</td>
                        <td class="wt-cell">
                            <div class="wt-title lvl-@row.Wt.Level">
                                @if (WorkInstructions.For(row.Wt.FullNumber) is string instr)
                                {
                                    <button type="button" class="info-btn" title="Как заполнять"
                                            @onclick="() => OpenInfo(row.Wt, instr)">?</button>
                                }
                                <span>@row.Wt.Title</span>
                            </div>
                        </td>
                        <td class="num">@RefPoints(row.Wt)</td>
                        <td>
                            <input type="number" step="1" class="control narrow"
                                   @bind="row.Value" @bind:after="() => AutoSaveRow(row)" />
                        </td>
                        <td class="num">@RowPoints(row).ToString("0.##")</td>
                        <td class="comment-cell">
                            <button type="button" class="comment-view @(string.IsNullOrWhiteSpace(row.Comment) ? "empty" : "")"
                                    @onclick="() => OpenComment(row)"
                                    title="@(string.IsNullOrWhiteSpace(row.Comment) ? "Добавить комментарий" : row.Comment)">
                                @if (!string.IsNullOrWhiteSpace(row.Comment))
                                {
                                    <span class="comment-preview">@row.Comment</span>
                                }
                                <span class="comment-pen" aria-hidden="true">✎</span>
                            </button>
                        </td>
                        <td class="file-cell">
                            <div class="file-box">
                                @for (var i = 0; i < row.Files.Count; i++)
                                {
                                    var f = row.Files[i];
                                    var docName = WorkFileNaming.Build(row.Wt.FullNumber, i + 1, f.Name);
                                    <div class="file-item">
                                        <a class="file-link" href="/workfiles/@f.Id" target="_blank"
                                           title="@docName (исходное имя: @f.Name)">📎 @docName</a>
                                        <button type="button" class="file-x" title="Удалить файл"
                                                @onclick="() => RemoveFile(row, f.Id)">×</button>
                                    </div>
                                }
                                @foreach (var nf in row.NewFiles)
                                {
                                    <div class="hint small">⏳ @nf.Name</div>
                                }
                                <InputFile multiple OnChange="e => OnFilesSelected(row, e)" />
                            </div>
                        </td>
                    </tr>
                    }
                }
            }
        </tbody>
    </table>
    </div>
}

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task<string> CurrentUser()
    {
        if (AuthState == null) return "—";
        var s = await AuthState;
        return s.User.Identity?.Name ?? "—";
    }

    private List<Department> departments = new();
    private List<Teacher> teachers = new();
    private List<WorkType> workTypes = new();
    private List<Row> rows = new();

    private int selectedTeacherId;

    /// <summary>Права и справочники получены. До этого страница показывает заглушку.</summary>
    private bool loaded;

    // права текущей учётной записи (берутся из БД при загрузке — см. UserService.GetByLoginAsync)
    private bool isAdmin;
    private int? myTeacherId;
    private string? myDepartmentName;

    private List<string> years = Periods.List();
    private string academicYear = Periods.CurrentAcademicYear();
    private int semester = 2;

    private string? saveMessage;
    private bool busy;
    private string busyText = "";

    // отметка «Заполнено»
    private bool isCompleted;

    private async Task ToggleCompleted()
    {
        if (selectedTeacherId == 0) return;
        isCompleted = !isCompleted;
        await Completion.SetAsync(selectedTeacherId, academicYear, semester, isCompleted, await CurrentUser());
        Audit.Log(await CurrentUser(),
            $"{(isCompleted ? "Отмечено «Заполнено»" : "Снята отметка «Заполнено»")} — «{TeacherName()}», {academicYear}, {semester} сем.");
        saveMessage = isCompleted ? "Отмечено как заполнено" : "Отметка снята";
    }

    // ---- редактор комментария (модальное окно) ----
    // В ячейке таблицы комментарии не помещаются (реальные — до ~500 символов,
    // с перечнями и ссылками), поэтому правка вынесена в отдельное окно.
    private Row? commentRow;
    private string commentDraft = "";
    private ElementReference commentEditor;
    private bool focusCommentEditor;

    private void OpenComment(Row row)
    {
        commentRow = row;
        commentDraft = row.Comment ?? "";
        focusCommentEditor = true;
    }

    private void CloseComment()
    {
        commentRow = null;
        commentDraft = "";
    }

    private async Task SaveComment()
    {
        if (commentRow is not Row row) return;
        row.Comment = string.IsNullOrWhiteSpace(commentDraft) ? null : commentDraft.Trim();
        CloseComment();
        await AutoSaveRow(row);
    }

    private async Task OnCommentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseComment();
        else if (e.Key == "Enter" && e.CtrlKey) await SaveComment();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusCommentEditor)
        {
            focusCommentEditor = false;
            await commentEditor.FocusAsync();
        }
    }

    // окно-инструкция
    private string? infoTitle;
    private string? infoText;

    /// <summary>Расшифровка «за что сколько» для окна «?»: пусто, если балл единственный.</summary>
    private record ScoreLine(string Label, decimal Points);
    private List<ScoreLine> infoScores = new();

    private void OpenInfo(WorkType wt, string text)
    {
        infoTitle = $"п. {wt.FullNumber}. {wt.Title}";
        infoText = text;
        infoScores = BuildScoreLines(wt);
    }

    private static List<ScoreLine> BuildScoreLines(WorkType wt)
    {
        if (wt.Options.Count > 0)
            return wt.Options
                .OrderBy(o => o.DisplayOrder)
                .Select(o => new ScoreLine(o.Label, o.Points))
                .ToList();

        if (wt.InputKind == ScoreInputKind.Quantity && wt.UnitPoints is decimal unit)
            return new() { new ScoreLine($"За 1 {wt.UnitName ?? "ед."}", unit) };

        return new();
    }

    private async Task OnFilesSelected(Row row, InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(20))
            row.NewFiles.Add(f);
        busy = true;
        busyText = "Загрузка файлов…";
        StateHasChanged();
        try { await AutoSaveRow(row); }
        finally { busy = false; }
    }

    private async Task RemoveFile(Row row, int fileId)
    {
        if (!row.RemoveFileIds.Contains(fileId)) row.RemoveFileIds.Add(fileId);
        await AutoSaveRow(row);
    }

    /// <summary>Состояние одной строки таблицы (один вид работы).</summary>
    private class Row
    {
        public WorkType Wt = default!;
        public int? EntryId;                 // основная запись, если есть
        public List<int> ExtraEntryIds = new(); // прежние дубликаты по этому виду — удаляются при сохранении
        public int Value;                    // баллы (целые) вводятся вручную для всех видов
        public string? Comment;
        public List<FileRef> Files = new();      // уже сохранённые файлы
        public List<IBrowserFile> NewFiles = new(); // выбранные для загрузки
        public List<int> RemoveFileIds = new();  // id файлов к удалению
    }

    private class FileRef
    {
        public int Id;
        public string Name = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var me = await UserSvc.GetByLoginAsync(await CurrentUser());
        isAdmin = me?.IsAdmin ?? false;
        myTeacherId = me?.TeacherId;
        myDepartmentName = me?.Teacher?.Department?.Name;

        await using var db = await DbFactory.CreateDbContextAsync();
        departments = await db.Departments.OrderBy(d => d.Name).ToListAsync();
        workTypes = await db.WorkTypes.Include(w => w.Options).ToListAsync();

        // обычный пользователь видит только своего преподавателя
        teachers = isAdmin
            ? await db.Teachers.OrderBy(t => t.FullName).ToListAsync()
            : await db.Teachers.Where(t => t.Id == myTeacherId).ToListAsync();

        if (!isAdmin && myTeacherId is int mine)
        {
            selectedTeacherId = mine;
            await LoadRows();
        }

        loaded = true;
    }

    private async Task LoadRows()
    {
        saveMessage = null;
        rows = new();
        if (selectedTeacherId == 0) { isCompleted = false; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entries = await db.WorkEntries
            .Include(e => e.WorkFiles)
            .Where(e => e.TeacherId == selectedTeacherId
                        && e.AcademicYear == academicYear
                        && e.Semester == semester)
            .ToListAsync();

        foreach (var wt in workTypes.OrderBy(w => w.Section).ThenBy(w => w.DisplayOrder))
        {
            var es = entries.Where(e => e.WorkTypeId == wt.Id).OrderBy(e => e.Id).ToList();
            var row = new Row { Wt = wt };

            if (es.Count > 0)
            {
                var primary = es[0];
                row.EntryId = primary.Id;
                row.ExtraEntryIds = es.Skip(1).Select(e => e.Id).ToList();
                row.Comment = primary.Comment;
                row.Value = (int)Math.Round(primary.Points);
                row.Files = primary.WorkFiles
                    .OrderBy(f => f.Id)
                    .Select(f => new FileRef { Id = f.Id, Name = f.OriginalFileName ?? f.StoredFileName })
                    .ToList();
            }

            rows.Add(row);
        }

        isCompleted = await Completion.IsCompletedAsync(selectedTeacherId, academicYear, semester);
    }

    private async Task OnTeacherChanged(ChangeEventArgs e)
    {
        if (!isAdmin) return; // обычный пользователь преподавателя не меняет
        selectedTeacherId = int.Parse(e.Value?.ToString() ?? "0");
        await LoadRows();
    }

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        academicYear = e.Value?.ToString() ?? academicYear;
        await LoadRows();
    }

    private async Task OnSemesterChanged(ChangeEventArgs e)
    {
        semester = int.Parse(e.Value?.ToString() ?? "2");
        await LoadRows();
    }

    // ---- расчёт ----
    private decimal RowPoints(Row r) => r.Value;

    private bool RowActive(Row r) => r.Value != 0;

    private decimal SectionRaw(WorkSection sec) =>
        rows.Where(r => r.Wt.Section == sec).Sum(RowPoints);

    private decimal RawGrandTotal()
    {
        decimal sum = 0;
        foreach (var sec in Enum.GetValues<WorkSection>())
            sum += ScoringRules.CapSection(SectionRaw(sec));
        return sum;
    }

    private decimal GrandTotal() => ScoringRules.CapTotal(RawGrandTotal());

    private void ShowSectionLimit(decimal raw, decimal capped)
    {
        infoTitle = "Лимит раздела";
        infoText = $"По каждому разделу засчитывается не более {ScoringRules.SectionCap:0.##} баллов.\n" +
                   $"Набрано: {raw:0.##}, к зачёту: {capped:0.##}.\n" +
                   $"Превышение ({raw - capped:0.##}) не учитывается.";
    }

    private void ShowTotalLimit(decimal raw, decimal total)
    {
        infoTitle = "Лимит итога";
        infoText = $"Итоговая сумма ограничена {ScoringRules.TotalCap:0.##} баллами и не может быть меньше {ScoringRules.TotalFloor:0.##}.\n" +
                   $"Набрано: {raw:0.##}, к зачёту: {total:0.##}.";
    }

    private static string RefPoints(WorkType w) => w.InputKind switch
    {
        ScoreInputKind.Fixed => w.FixedPoints?.ToString("0.##") ?? "",
        ScoreInputKind.Choice => string.Join("/", w.Options.OrderBy(o => o.DisplayOrder).Select(o => o.Points.ToString("0.##"))),
        ScoreInputKind.Quantity => $"{w.UnitPoints?.ToString("0.##")} балл за 1 практику",
        ScoreInputKind.Manual => "",
        _ => ""
    };

    // ---- автосохранение одной строки (при уходе с поля) ----
    private async Task AutoSaveRow(Row row)
    {
        if (selectedTeacherId == 0) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (RowActive(row) || row.NewFiles.Count > 0 || row.RemoveFileIds.Count > 0)
            {
                WorkEntry entry;
                if (row.EntryId is int id)
                {
                    entry = await db.WorkEntries.Include(e => e.WorkFiles).FirstAsync(x => x.Id == id);
                }
                else
                {
                    entry = new WorkEntry
                    {
                        TeacherId = selectedTeacherId,
                        AcademicYear = academicYear,
                        Semester = semester,
                        CreatedAt = DateTime.UtcNow
                    };
                    db.WorkEntries.Add(entry);
                }

                entry.WorkTypeId = row.Wt.Id;
                entry.ScoreOptionId = null;
                entry.Quantity = null;
                entry.Points = row.Value;
                entry.Comment = string.IsNullOrWhiteSpace(row.Comment) ? null : row.Comment!.Trim();

                // удаление отмеченных файлов
                if (row.RemoveFileIds.Count > 0)
                {
                    var toDelete = entry.WorkFiles.Where(f => row.RemoveFileIds.Contains(f.Id)).ToList();
                    foreach (var f in toDelete)
                    {
                        Storage.Delete(f.StoredFileName);
                        entry.WorkFiles.Remove(f);
                        db.WorkFiles.Remove(f);
                    }
                }

                // добавление новых файлов
                foreach (var nf in row.NewFiles)
                {
                    await using var stream = nf.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
                    var stored = await Storage.SaveAsync(stream, nf.Name);
                    entry.WorkFiles.Add(new WorkFile
                    {
                        StoredFileName = stored,
                        OriginalFileName = nf.Name,
                        CreatedAt = DateTime.UtcNow
                    });
                }

                await RemoveEntries(db, row.ExtraEntryIds);
                await db.SaveChangesAsync();

                row.EntryId = entry.Id;
                row.ExtraEntryIds.Clear();
                row.NewFiles.Clear();
                row.RemoveFileIds.Clear();
                row.Files = entry.WorkFiles
                    .OrderBy(f => f.Id)
                    .Select(f => new FileRef { Id = f.Id, Name = f.OriginalFileName ?? f.StoredFileName })
                    .ToList();

                Audit.Log(await CurrentUser(),
                    $"Показатель п. {row.Wt.FullNumber} = {entry.Points:0.##} б. — «{TeacherName()}», {academicYear}, {semester} сем.");
            }
            else
            {
                var ids = new List<int>();
                if (row.EntryId is int pid) ids.Add(pid);
                ids.AddRange(row.ExtraEntryIds);
                if (ids.Count > 0)
                {
                    await RemoveEntries(db, ids);
                    await db.SaveChangesAsync();
                    Audit.Log(await CurrentUser(),
                        $"Очищен показатель п. {row.Wt.FullNumber} — «{TeacherName()}», {academicYear}, {semester} сем.");
                }
                row.EntryId = null;
                row.ExtraEntryIds.Clear();
                row.Files.Clear();
                row.NewFiles.Clear();
                row.RemoveFileIds.Clear();
            }

            saveMessage = "Сохранено";
        }
        catch (Exception ex)
        {
            saveMessage = "Ошибка автосохранения: " + ex.Message;
        }
    }

    // ---- очистка таблицы / раздела ----
    private bool showClearConfirm;
    private WorkSection? pendingClearSection; // null = вся таблица

    private void ConfirmClearAll()
    {
        pendingClearSection = null;
        showClearConfirm = true;
    }

    private void ConfirmClearSection(WorkSection sec)
    {
        pendingClearSection = sec;
        showClearConfirm = true;
    }

    private async Task DoClear()
    {
        showClearConfirm = false;
        if (selectedTeacherId == 0) return;

        var scope = pendingClearSection is WorkSection sec
            ? rows.Where(r => r.Wt.Section == sec).ToList()
            : rows.ToList();

        busy = true;
        busyText = pendingClearSection is null ? "Очистка таблицы…" : "Очистка раздела…";
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var ids = new List<int>();
            foreach (var row in scope)
            {
                if (row.EntryId is int pid) ids.Add(pid);
                ids.AddRange(row.ExtraEntryIds);
            }
            if (ids.Count > 0)
            {
                await RemoveEntries(db, ids);
                await db.SaveChangesAsync();
            }

            foreach (var row in scope)
            {
                row.Value = 0;
                row.Comment = null;
                row.EntryId = null;
                row.ExtraEntryIds.Clear();
                row.Files.Clear();
                row.NewFiles.Clear();
                row.RemoveFileIds.Clear();
            }

            // полная очистка снимает отметку «Заполнено»
            if (pendingClearSection is null && isCompleted)
            {
                isCompleted = false;
                await Completion.SetAsync(selectedTeacherId, academicYear, semester, false, await CurrentUser());
            }

            Audit.Log(await CurrentUser(), pendingClearSection is WorkSection s
                ? $"Очищен раздел {(int)s} преподавателя «{TeacherName()}» за {academicYear}, {semester} сем."
                : $"Очищена вся таблица преподавателя «{TeacherName()}» за {academicYear}, {semester} сем.");
            saveMessage = "Очищено";
        }
        catch (Exception ex)
        {
            saveMessage = "Ошибка очистки: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemoveEntries(AppDbContext db, IEnumerable<int> ids)
    {
        foreach (var did in ids)
        {
            var d = await db.WorkEntries.Include(e => e.WorkFiles).FirstOrDefaultAsync(e => e.Id == did);
            if (d == null) continue;
            foreach (var wf in d.WorkFiles) Storage.Delete(wf.StoredFileName);
            if (!string.IsNullOrEmpty(d.StoredFileName)) Storage.Delete(d.StoredFileName);
            db.WorkEntries.Remove(d); // WorkFiles удалятся каскадом
        }
    }

    private string TeacherName() => teachers.FirstOrDefault(t => t.Id == selectedTeacherId)?.FullName ?? "";

    private void GoToReport()
    {
        var dept = teachers.FirstOrDefault(t => t.Id == selectedTeacherId)?.DepartmentId ?? 0;
        Nav.NavigateTo($"report?year={Uri.EscapeDataString(academicYear)}&sem={semester}&dept={dept}");
    }
}
