@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FileStorageService Storage
@inject AuditLogger Audit
@inject NavigationManager Nav

<PageTitle>Ввод показателей</PageTitle>

<h1>Индивидуальные показатели работы преподавателя</h1>

<div class="toolbar">
    <div class="field">
        <label>Преподаватель</label>
        <div class="row">
            <select class="control" value="@selectedTeacherId" @onchange="OnTeacherChanged">
                <option value="0">— выберите —</option>
                @foreach (var d in departments)
                {
                    <optgroup label="@d.Name">
                        @foreach (var t in teachers.Where(t => t.DepartmentId == d.Id))
                        {
                            <option value="@t.Id">@t.FullName</option>
                        }
                    </optgroup>
                }
            </select>
            <button class="btn" @onclick="() => showAddTeacher = true">+ Преподаватель</button>
            <button class="btn danger" disabled="@(selectedTeacherId == 0)"
                    @onclick="OpenDeleteTeacher" title="Удалить выбранного преподавателя">
                Удалить
            </button>
        </div>
    </div>

    <div class="field">
        <label>Учебный год</label>
        <select class="control" value="@academicYear" @onchange="OnPeriodChanged">
            @foreach (var y in years)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>

    <div class="field">
        <label>Семестр</label>
        <select class="control" value="@semester" @onchange="OnSemesterChanged">
            @foreach (var s in Periods.Semesters)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
</div>

@if (showAddTeacher)
{
    <div class="modal-backdrop" @onclick="() => showAddTeacher = false">
        <div class="modal" @onclick:stopPropagation>
            <h3>Новый преподаватель</h3>
            <div class="field">
                <label>Фамилия И.О.</label>
                <input class="control" @bind="newTeacherName" placeholder="Иванов И. И." />
            </div>
            <div class="field">
                <label>Кафедра</label>
                <select class="control" @bind="newTeacherDeptId">
                    <option value="0">— выберите —</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrEmpty(teacherError))
            {
                <div class="error">@teacherError</div>
            }
            <div class="modal-actions">
                <button class="btn" @onclick="() => showAddTeacher = false">Отмена</button>
                <button class="btn primary" @onclick="AddTeacher">Сохранить</button>
            </div>
        </div>
    </div>
}

@if (showDeleteTeacher)
{
    <div class="modal-backdrop" @onclick="() => showDeleteTeacher = false">
        <div class="modal" @onclick:stopPropagation>
            <h3>Удалить преподавателя?</h3>
            <p>
                Вы действительно хотите удалить преподавателя
                <strong>@deleteTeacherName</strong>@(string.IsNullOrEmpty(deleteTeacherDept) ? "" : $" (кафедра «{deleteTeacherDept}»)")?
            </p>
            @if (deleteEntryCount > 0)
            {
                <div class="hint-box">
                    Вместе с преподавателем будут безвозвратно удалены все внесённые им работы
                    (@deleteEntryCount шт.) за все периоды и прикреплённые к ним файлы.
                </div>
            }
            <p class="hint">Действие необратимо.</p>
            @if (!string.IsNullOrEmpty(deleteError))
            {
                <div class="error">@deleteError</div>
            }
            <div class="modal-actions">
                <button class="btn" @onclick="() => showDeleteTeacher = false">Отмена</button>
                <button class="btn danger" disabled="@deleting" @onclick="ConfirmDeleteTeacher">
                    @(deleting ? "Удаляю…" : "Удалить")
                </button>
            </div>
        </div>
    </div>
}

@if (selectedTeacherId == 0)
{
    <p class="hint">Выберите преподавателя, чтобы заполнить показатели за выбранный период.</p>
}
else
{
    <div class="totals-bar">
        @foreach (var sec in Enum.GetValues<WorkSection>())
        {
            var raw = SectionRaw(sec);
            var capped = ScoringRules.CapSection(raw);
            <div class="total-chip @(capped != raw ? "capped" : "")" title="@sec.Title()">
                <span class="sec-num">Раздел @((int)sec)</span>
                <span class="sec-val">@capped.ToString("0.##")@(capped != raw ? $" / {raw:0.##}" : "")</span>
            </div>
        }
        <div class="total-chip grand">
            <span class="sec-num">ИТОГО</span>
            <span class="sec-val">@GrandTotal().ToString("0.##")</span>
        </div>
    </div>

    <table class="grid sheet">
        <thead>
            <tr>
                <th style="width:54px">№</th>
                <th>Вид работы</th>
                <th style="width:90px">Баллы</th>
                <th style="width:210px">Заполнение</th>
                <th style="width:70px">Балл</th>
                <th style="width:260px">Комментарий</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sec in Enum.GetValues<WorkSection>())
            {
                var secRows = rows.Where(r => r.Wt.Section == sec).ToList();
                if (secRows.Count == 0) { continue; }
                var raw = SectionRaw(sec);
                var capped = ScoringRules.CapSection(raw);
                <tr class="section-row">
                    <td colspan="4">@sec.FullTitle()</td>
                    <td class="num">@capped.ToString("0.##")@(capped != raw ? $" / {raw:0.##}" : "")</td>
                    <td></td>
                </tr>
                @foreach (var row in secRows)
                {
                    <tr>
                        <td>@row.Wt.Number</td>
                        <td>
                            @row.Wt.Title
                            @if (!string.IsNullOrEmpty(row.Wt.Hint))
                            {
                                <div class="hint small">@row.Wt.Hint</div>
                            }
                            @if (row.EntryId is int fid && row.HasFile)
                            {
                                <div class="hint small">📎 <a href="/files/@fid" target="_blank">@row.OriginalFileName</a></div>
                            }
                        </td>
                        <td class="num">@RefPoints(row.Wt)</td>
                        <td>
                            @switch (row.Wt.InputKind)
                            {
                                case ScoreInputKind.Fixed:
                                    <label class="cell-check">
                                        <input type="checkbox" @bind="row.Included" /> учтено
                                    </label>
                                    break;
                                case ScoreInputKind.Choice:
                                    <select class="control" value="@(row.OptionId?.ToString() ?? "")"
                                            @onchange="e => OnOption(row, e)">
                                        <option value="">— нет —</option>
                                        @foreach (var op in row.Wt.Options.OrderBy(o => o.DisplayOrder))
                                        {
                                            <option value="@op.Id">@op.Label — @op.Points.ToString("0.##") б.</option>
                                        }
                                    </select>
                                    break;
                                case ScoreInputKind.Manual:
                                    <input type="number" step="0.5" class="control narrow" @bind="row.Manual" />
                                    break;
                                case ScoreInputKind.Quantity:
                                    <div class="row">
                                        <input type="number" min="0" step="1" class="control narrow" @bind="row.Quantity" />
                                        <span class="hint small">× @row.Wt.UnitPoints?.ToString("0.##") @row.Wt.UnitName</span>
                                    </div>
                                    break;
                            }
                        </td>
                        <td class="num">@RowPoints(row).ToString("0.##")</td>
                        <td><input class="control comment-input" @bind="row.Comment" /></td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="footer-actions sheet-actions">
        @if (!string.IsNullOrEmpty(saveMessage))
        {
            <span class="save-msg">@saveMessage</span>
        }
        <button class="btn" @onclick="GoToReport">Перейти к отчётам →</button>
        <button class="btn primary big" disabled="@saving" @onclick="Save">
            @(saving ? "Сохраняю…" : "Сохранить")
        </button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task<string> CurrentUser()
    {
        if (AuthState == null) return "—";
        var s = await AuthState;
        return s.User.Identity?.Name ?? "—";
    }

    private List<Department> departments = new();
    private List<Teacher> teachers = new();
    private List<WorkType> workTypes = new();
    private List<Row> rows = new();

    private int selectedTeacherId;
    private List<string> years = Periods.List();
    private string academicYear = Periods.CurrentAcademicYear();
    private int semester = 2;

    private bool saving;
    private string? saveMessage;

    // добавление преподавателя
    private bool showAddTeacher;
    private string newTeacherName = "";
    private int newTeacherDeptId;
    private string? teacherError;

    // удаление преподавателя
    private bool showDeleteTeacher;
    private bool deleting;
    private string? deleteTeacherName;
    private string? deleteTeacherDept;
    private int deleteEntryCount;
    private string? deleteError;

    /// <summary>Состояние одной строки таблицы (один вид работы).</summary>
    private class Row
    {
        public WorkType Wt = default!;
        public int? EntryId;                 // основная запись, если есть
        public List<int> ExtraEntryIds = new(); // прежние дубликаты по этому виду — удаляются при сохранении
        public bool Included;                // Fixed
        public int? OptionId;                // Choice
        public decimal Manual;               // Manual
        public int Quantity;                 // Quantity
        public string? Comment;
        public bool HasFile;
        public string? OriginalFileName;
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        departments = await db.Departments.OrderBy(d => d.Name).ToListAsync();
        teachers = await db.Teachers.OrderBy(t => t.FullName).ToListAsync();
        workTypes = await db.WorkTypes.Include(w => w.Options).ToListAsync();
    }

    private async Task LoadRows()
    {
        saveMessage = null;
        rows = new();
        if (selectedTeacherId == 0) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entries = await db.WorkEntries
            .Where(e => e.TeacherId == selectedTeacherId
                        && e.AcademicYear == academicYear
                        && e.Semester == semester)
            .ToListAsync();

        foreach (var wt in workTypes.OrderBy(w => w.Section).ThenBy(w => w.DisplayOrder))
        {
            var es = entries.Where(e => e.WorkTypeId == wt.Id).OrderBy(e => e.Id).ToList();
            var row = new Row { Wt = wt };

            if (es.Count > 0)
            {
                var primary = es[0];
                row.EntryId = primary.Id;
                row.ExtraEntryIds = es.Skip(1).Select(e => e.Id).ToList();
                row.Comment = primary.Comment;
                row.HasFile = !string.IsNullOrEmpty(primary.StoredFileName);
                row.OriginalFileName = primary.OriginalFileName;

                switch (wt.InputKind)
                {
                    case ScoreInputKind.Fixed: row.Included = true; break;
                    case ScoreInputKind.Choice: row.OptionId = primary.ScoreOptionId; break;
                    case ScoreInputKind.Manual: row.Manual = primary.Points; break;
                    case ScoreInputKind.Quantity: row.Quantity = primary.Quantity ?? 0; break;
                }
            }

            rows.Add(row);
        }
    }

    private async Task OnTeacherChanged(ChangeEventArgs e)
    {
        selectedTeacherId = int.Parse(e.Value?.ToString() ?? "0");
        await LoadRows();
    }

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        academicYear = e.Value?.ToString() ?? academicYear;
        await LoadRows();
    }

    private async Task OnSemesterChanged(ChangeEventArgs e)
    {
        semester = int.Parse(e.Value?.ToString() ?? "2");
        await LoadRows();
    }

    private void OnOption(Row row, ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        row.OptionId = string.IsNullOrEmpty(v) ? null : int.Parse(v);
    }

    // ---- расчёт ----
    private decimal RowPoints(Row r) => r.Wt.InputKind switch
    {
        ScoreInputKind.Fixed => r.Included ? (r.Wt.FixedPoints ?? 0) : 0,
        ScoreInputKind.Choice => r.OptionId.HasValue
            ? (r.Wt.Options.FirstOrDefault(o => o.Id == r.OptionId)?.Points ?? 0) : 0,
        ScoreInputKind.Manual => r.Manual,
        ScoreInputKind.Quantity => r.Quantity > 0 ? (r.Wt.UnitPoints ?? 0) * r.Quantity : 0,
        _ => 0
    };

    private bool RowActive(Row r) => r.Wt.InputKind switch
    {
        ScoreInputKind.Fixed => r.Included,
        ScoreInputKind.Choice => r.OptionId.HasValue,
        ScoreInputKind.Manual => r.Manual != 0,
        ScoreInputKind.Quantity => r.Quantity > 0,
        _ => false
    };

    private decimal SectionRaw(WorkSection sec) =>
        rows.Where(r => r.Wt.Section == sec).Sum(RowPoints);

    private decimal GrandTotal()
    {
        decimal sum = 0;
        foreach (var sec in Enum.GetValues<WorkSection>())
            sum += ScoringRules.CapSection(SectionRaw(sec));
        return ScoringRules.CapTotal(sum);
    }

    private static string RefPoints(WorkType w) => w.InputKind switch
    {
        ScoreInputKind.Fixed => w.FixedPoints?.ToString("0.##") ?? "",
        ScoreInputKind.Choice => string.Join("/", w.Options.OrderBy(o => o.DisplayOrder).Select(o => o.Points.ToString("0.##"))),
        ScoreInputKind.Quantity => $"{w.UnitPoints?.ToString("0.##")} балл за 1 практику",
        ScoreInputKind.Manual => "",
        _ => ""
    };

    // ---- сохранение всей таблицы ----
    private async Task Save()
    {
        if (selectedTeacherId == 0) return;
        saving = true;
        saveMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            foreach (var row in rows)
            {
                if (RowActive(row))
                {
                    WorkEntry entry;
                    if (row.EntryId is int id)
                    {
                        entry = await db.WorkEntries.FirstAsync(x => x.Id == id);
                    }
                    else
                    {
                        entry = new WorkEntry
                        {
                            TeacherId = selectedTeacherId,
                            AcademicYear = academicYear,
                            Semester = semester,
                            CreatedAt = DateTime.UtcNow
                        };
                        db.WorkEntries.Add(entry);
                    }

                    entry.WorkTypeId = row.Wt.Id;
                    entry.ScoreOptionId = row.Wt.InputKind == ScoreInputKind.Choice ? row.OptionId : null;
                    entry.Quantity = row.Wt.InputKind == ScoreInputKind.Quantity ? row.Quantity : null;
                    entry.Points = RowPoints(row);
                    entry.Comment = string.IsNullOrWhiteSpace(row.Comment) ? null : row.Comment!.Trim();
                    // файл-вложение (если было) намеренно не трогаем

                    await RemoveEntries(db, row.ExtraEntryIds);
                }
                else
                {
                    var ids = new List<int>();
                    if (row.EntryId is int pid) ids.Add(pid);
                    ids.AddRange(row.ExtraEntryIds);
                    await RemoveEntries(db, ids);
                }
            }

            await db.SaveChangesAsync();
            Audit.Log(await CurrentUser(),
                $"Сохранены показатели преподавателя «{TeacherName()}» за {academicYear}, {semester} сем. (итог {GrandTotal():0.##})");
            saveMessage = "Сохранено.";
            await LoadRows();
        }
        catch (Exception ex)
        {
            saveMessage = "Ошибка сохранения: " + ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task RemoveEntries(AppDbContext db, IEnumerable<int> ids)
    {
        foreach (var did in ids)
        {
            var d = await db.WorkEntries.FindAsync(did);
            if (d == null) continue;
            if (!string.IsNullOrEmpty(d.StoredFileName)) Storage.Delete(d.StoredFileName);
            db.WorkEntries.Remove(d);
        }
    }

    private string TeacherName() => teachers.FirstOrDefault(t => t.Id == selectedTeacherId)?.FullName ?? "";

    // ---- преподаватели ----
    private async Task AddTeacher()
    {
        teacherError = null;
        if (string.IsNullOrWhiteSpace(newTeacherName)) { teacherError = "Укажите ФИО."; return; }
        if (newTeacherDeptId == 0) { teacherError = "Выберите кафедру."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var t = new Teacher { FullName = newTeacherName.Trim(), DepartmentId = newTeacherDeptId };
        db.Teachers.Add(t);
        await db.SaveChangesAsync();
        Audit.Log(await CurrentUser(), $"Добавлен преподаватель «{t.FullName}»");

        teachers.Add(t);
        teachers = teachers.OrderBy(x => x.FullName).ToList();
        selectedTeacherId = t.Id;
        newTeacherName = "";
        newTeacherDeptId = 0;
        showAddTeacher = false;
        await LoadRows();
    }

    private async Task OpenDeleteTeacher()
    {
        if (selectedTeacherId == 0) return;
        deleteError = null;
        var t = teachers.FirstOrDefault(x => x.Id == selectedTeacherId);
        deleteTeacherName = t?.FullName;
        deleteTeacherDept = departments.FirstOrDefault(d => d.Id == t?.DepartmentId)?.Name;

        await using var db = await DbFactory.CreateDbContextAsync();
        deleteEntryCount = await db.WorkEntries.CountAsync(e => e.TeacherId == selectedTeacherId);

        showDeleteTeacher = true;
    }

    private async Task ConfirmDeleteTeacher()
    {
        if (selectedTeacherId == 0) return;
        deleting = true;
        deleteError = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var stored = await db.WorkEntries
                .Where(e => e.TeacherId == selectedTeacherId && e.StoredFileName != null)
                .Select(e => e.StoredFileName!)
                .ToListAsync();
            foreach (var f in stored) Storage.Delete(f);

            var teacher = await db.Teachers.FindAsync(selectedTeacherId);
            if (teacher != null)
            {
                db.Teachers.Remove(teacher);
                await db.SaveChangesAsync();
            }

            teachers.RemoveAll(x => x.Id == selectedTeacherId);
            selectedTeacherId = 0;
            rows = new();
            showDeleteTeacher = false;
            Audit.Log(await CurrentUser(), $"Удалён преподаватель «{deleteTeacherName}» (записей: {deleteEntryCount})");
        }
        catch (Exception ex)
        {
            deleteError = "Не удалось удалить: " + ex.Message;
        }
        finally
        {
            deleting = false;
        }
    }

    private void GoToReport()
    {
        var dept = teachers.FirstOrDefault(t => t.Id == selectedTeacherId)?.DepartmentId ?? 0;
        Nav.NavigateTo($"report?year={Uri.EscapeDataString(academicYear)}&sem={semester}&dept={dept}");
    }
}
