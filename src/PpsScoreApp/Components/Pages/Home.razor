@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FileStorageService Storage
@inject NavigationManager Nav

<PageTitle>Ввод показателей</PageTitle>

<h1>Индивидуальные показатели работы преподавателя</h1>

<div class="toolbar">
    <div class="field">
        <label>Преподаватель</label>
        <div class="row">
            <select class="control" value="@selectedTeacherId" @onchange="OnTeacherChanged">
                <option value="0">— выберите —</option>
                @foreach (var d in departments)
                {
                    <optgroup label="@d.Name">
                        @foreach (var t in teachers.Where(t => t.DepartmentId == d.Id))
                        {
                            <option value="@t.Id">@t.FullName</option>
                        }
                    </optgroup>
                }
            </select>
            <button class="btn" @onclick="() => showAddTeacher = true">+ Преподаватель</button>
            <button class="btn danger" disabled="@(selectedTeacherId == 0)"
                    @onclick="OpenDeleteTeacher" title="Удалить выбранного преподавателя">
                Удалить
            </button>
        </div>
    </div>

    <div class="field">
        <label>Учебный год</label>
        <select class="control" value="@academicYear" @onchange="OnPeriodChanged">
            @foreach (var y in years)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>

    <div class="field">
        <label>Семестр</label>
        <select class="control" value="@semester" @onchange="OnSemesterChanged">
            @foreach (var s in Periods.Semesters)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>

    <div class="field grow"></div>

    <div class="field">
        <label>&nbsp;</label>
        <button class="btn primary" disabled="@(selectedTeacherId == 0)" @onclick="OpenAddEntry">+ Добавить работу</button>
    </div>
</div>

@if (showAddTeacher)
{
    <div class="modal-backdrop" @onclick="() => showAddTeacher = false">
        <div class="modal" @onclick:stopPropagation>
            <h3>Новый преподаватель</h3>
            <div class="field">
                <label>Фамилия И.О.</label>
                <input class="control" @bind="newTeacherName" placeholder="Иванов И. И." />
            </div>
            <div class="field">
                <label>Кафедра</label>
                <select class="control" @bind="newTeacherDeptId">
                    <option value="0">— выберите —</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrEmpty(teacherError))
            {
                <div class="error">@teacherError</div>
            }
            <div class="modal-actions">
                <button class="btn" @onclick="() => showAddTeacher = false">Отмена</button>
                <button class="btn primary" @onclick="AddTeacher">Сохранить</button>
            </div>
        </div>
    </div>
}

@if (showDeleteTeacher)
{
    <div class="modal-backdrop" @onclick="() => showDeleteTeacher = false">
        <div class="modal" @onclick:stopPropagation>
            <h3>Удалить преподавателя?</h3>
            <p>
                Вы действительно хотите удалить преподавателя
                <strong>@deleteTeacherName</strong>@(string.IsNullOrEmpty(deleteTeacherDept) ? "" : $" (кафедра «{deleteTeacherDept}»)")?
            </p>
            @if (deleteEntryCount > 0)
            {
                <div class="hint-box">
                    Вместе с преподавателем будут безвозвратно удалены все внесённые им работы
                    (@deleteEntryCount шт.) за все периоды и прикреплённые к ним файлы.
                </div>
            }
            <p class="hint">Действие необратимо.</p>
            @if (!string.IsNullOrEmpty(deleteError))
            {
                <div class="error">@deleteError</div>
            }
            <div class="modal-actions">
                <button class="btn" @onclick="() => showDeleteTeacher = false">Отмена</button>
                <button class="btn danger" disabled="@deleting" @onclick="ConfirmDeleteTeacher">
                    @(deleting ? "Удаляю…" : "Удалить")
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="totals-bar">
        @foreach (var sec in Enum.GetValues<WorkSection>())
        {
            var raw = SectionRaw(sec);
            var capped = ScoringRules.CapSection(raw);
            <div class="total-chip @(capped != raw ? "capped" : "")" title="@sec.Title()">
                <span class="sec-num">Раздел @((int)sec)</span>
                <span class="sec-val">@capped.ToString("0.##")@(capped != raw ? $" / {raw:0.##}" : "")</span>
            </div>
        }
        <div class="total-chip grand">
            <span class="sec-num">ИТОГО</span>
            <span class="sec-val">@GrandTotal().ToString("0.##")</span>
        </div>
    </div>

    @if (entries.Count == 0)
    {
        <p class="hint">За этот период работ ещё не внесено.</p>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th style="width:70px">№</th>
                    <th>Вид работы</th>
                    <th style="width:80px">Баллы</th>
                    <th>Пояснение</th>
                    <th style="width:140px">Файл</th>
                    <th style="width:130px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grp in entries.GroupBy(e => e.WorkType!.Section).OrderBy(g => g.Key))
                {
                    <tr class="section-row">
                        <td colspan="6">@grp.Key.FullTitle()</td>
                    </tr>
                    @foreach (var e in grp.OrderBy(e => e.WorkType!.DisplayOrder))
                    {
                        <tr>
                            <td>@e.WorkType!.FullNumber</td>
                            <td>
                                @e.WorkType.Title
                                @if (e.ScoreOption != null)
                                {
                                    <span class="detail"> — @e.ScoreOption.Label</span>
                                }
                                else if (e.Quantity.HasValue)
                                {
                                    <span class="detail"> — @e.Quantity × @e.WorkType.UnitName</span>
                                }
                            </td>
                            <td class="num">@e.Points.ToString("0.##")</td>
                            <td class="comment">@e.Comment</td>
                            <td>
                                @if (e.HasFile)
                                {
                                    <a href="/files/@e.Id" target="_blank">@e.OriginalFileName</a>
                                }
                            </td>
                            <td class="actions">
                                <button class="btn small" @onclick="() => OpenEditEntry(e)">Изм.</button>
                                <button class="btn small danger" @onclick="() => DeleteEntry(e)">Удал.</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }

    <div class="footer-actions">
        <button class="btn primary big" @onclick="GoToReport">Сформировать отчёт →</button>
    </div>
}

@if (showEntry)
{
    <div class="modal-backdrop" @onclick="CloseEntry">
        <div class="modal wide" @onclick:stopPropagation>
            <h3>@(editingId == 0 ? "Добавить работу" : "Редактировать работу")</h3>

            <div class="field">
                <label>Раздел</label>
                <select class="control" value="@draftSection" @onchange="OnDraftSectionChanged">
                    @foreach (var sec in Enum.GetValues<WorkSection>())
                    {
                        <option value="@((int)sec)">@sec.FullTitle()</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Вид работы</label>
                <select class="control" value="@draftWorkTypeId" @onchange="OnDraftWorkTypeChanged">
                    <option value="0">— выберите —</option>
                    @foreach (var w in workTypes.Where(w => (int)w.Section == draftSection).OrderBy(w => w.DisplayOrder))
                    {
                        <option value="@w.Id">@w.FullNumber. @w.Title</option>
                    }
                </select>
            </div>

            @if (draftWorkType != null)
            {
                @if (!string.IsNullOrEmpty(draftWorkType.Hint))
                {
                    <div class="hint-box">@draftWorkType.Hint</div>
                }

                @switch (draftWorkType.InputKind)
                {
                    case ScoreInputKind.Fixed:
                        <div class="field">
                            <label>Баллы</label>
                            <div class="readonly-points">@draftWorkType.FixedPoints?.ToString("0.##")</div>
                        </div>
                        break;

                    case ScoreInputKind.Choice:
                        <div class="field">
                            <label>Вариант</label>
                            <select class="control" value="@draftOptionId" @onchange="OnDraftOptionChanged">
                                <option value="0">— выберите вариант —</option>
                                @foreach (var op in draftWorkType.Options.OrderBy(o => o.DisplayOrder))
                                {
                                    <option value="@op.Id">@op.Label — @op.Points.ToString("0.##") б.</option>
                                }
                            </select>
                        </div>
                        break;

                    case ScoreInputKind.Manual:
                        <div class="field">
                            <label>Баллы (устанавливаются вручную)</label>
                            <input type="number" step="0.5" class="control" @bind="draftManualPoints" />
                        </div>
                        break;

                    case ScoreInputKind.Quantity:
                        <div class="field">
                            <label>Количество (@draftWorkType.UnitName), по @draftWorkType.UnitPoints?.ToString("0.##") б. за единицу</label>
                            <input type="number" step="1" min="0" class="control" @bind="draftQuantity" />
                            <div class="hint">Итого: @ComputeDraftPoints().ToString("0.##") б.</div>
                        </div>
                        break;
                }

                <div class="field">
                    <label>Комментарий (необязательно)</label>
                    <textarea class="control" rows="2" @bind="draftComment"></textarea>
                </div>

                <div class="field">
                    <label>Файл-подтверждение (необязательно)</label>
                    <InputFile OnChange="OnFileSelected" />
                    @if (!string.IsNullOrEmpty(draftExistingFileName))
                    {
                        <div class="hint">
                            Текущий файл: @draftExistingFileName
                            <button class="btn small" @onclick="RemoveDraftFile">убрать</button>
                        </div>
                    }
                    @if (draftFile != null)
                    {
                        <div class="hint">Новый файл: @draftFile.Name</div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(entryError))
            {
                <div class="error">@entryError</div>
            }

            <div class="modal-actions">
                <button class="btn" @onclick="CloseEntry">Отмена</button>
                <button class="btn primary" @onclick="SaveEntry">Сохранить</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Department> departments = new();
    private List<Teacher> teachers = new();
    private List<WorkType> workTypes = new();
    private List<WorkEntry> entries = new();

    private int selectedTeacherId;
    private List<string> years = Periods.List();
    private string academicYear = Periods.CurrentAcademicYear();
    private int semester = 2;

    // add teacher
    private bool showAddTeacher;
    private string newTeacherName = "";
    private int newTeacherDeptId;
    private string? teacherError;

    // entry modal
    private bool showEntry;
    private int editingId;
    private int draftSection = 1;
    private int draftWorkTypeId;
    private WorkType? draftWorkType;
    private int draftOptionId;
    private decimal draftManualPoints;
    private int draftQuantity;
    private string? draftComment;
    private IBrowserFile? draftFile;
    private string? draftExistingFileName;
    private string? draftExistingStoredName;
    private bool draftRemoveFile;
    private string? entryError;

    // удаление преподавателя
    private bool showDeleteTeacher;
    private bool deleting;
    private string? deleteTeacherName;
    private string? deleteTeacherDept;
    private int deleteEntryCount;
    private string? deleteError;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        departments = await db.Departments.OrderBy(d => d.Name).ToListAsync();
        teachers = await db.Teachers.OrderBy(t => t.FullName).ToListAsync();
        workTypes = await db.WorkTypes.Include(w => w.Options).ToListAsync();
    }

    private async Task LoadEntries()
    {
        if (selectedTeacherId == 0) { entries = new(); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        entries = await db.WorkEntries
            .Include(e => e.WorkType).ThenInclude(w => w!.Options)
            .Include(e => e.ScoreOption)
            .Where(e => e.TeacherId == selectedTeacherId
                        && e.AcademicYear == academicYear
                        && e.Semester == semester)
            .ToListAsync();
    }

    private async Task OnTeacherChanged(ChangeEventArgs e)
    {
        selectedTeacherId = int.Parse(e.Value?.ToString() ?? "0");
        await LoadEntries();
    }

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        academicYear = e.Value?.ToString() ?? academicYear;
        await LoadEntries();
    }

    private async Task OnSemesterChanged(ChangeEventArgs e)
    {
        semester = int.Parse(e.Value?.ToString() ?? "2");
        await LoadEntries();
    }

    private async Task AddTeacher()
    {
        teacherError = null;
        if (string.IsNullOrWhiteSpace(newTeacherName)) { teacherError = "Укажите ФИО."; return; }
        if (newTeacherDeptId == 0) { teacherError = "Выберите кафедру."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var t = new Teacher { FullName = newTeacherName.Trim(), DepartmentId = newTeacherDeptId };
        db.Teachers.Add(t);
        await db.SaveChangesAsync();

        teachers.Add(t);
        teachers = teachers.OrderBy(x => x.FullName).ToList();
        selectedTeacherId = t.Id;
        newTeacherName = "";
        newTeacherDeptId = 0;
        showAddTeacher = false;
        await LoadEntries();
    }

    // ---- удаление преподавателя ----
    private async Task OpenDeleteTeacher()
    {
        if (selectedTeacherId == 0) return;
        deleteError = null;
        var t = teachers.FirstOrDefault(x => x.Id == selectedTeacherId);
        deleteTeacherName = t?.FullName;
        deleteTeacherDept = departments.FirstOrDefault(d => d.Id == t?.DepartmentId)?.Name;

        await using var db = await DbFactory.CreateDbContextAsync();
        deleteEntryCount = await db.WorkEntries.CountAsync(e => e.TeacherId == selectedTeacherId);

        showDeleteTeacher = true;
    }

    private async Task ConfirmDeleteTeacher()
    {
        if (selectedTeacherId == 0) return;
        deleting = true;
        deleteError = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // сперва удаляем прикреплённые файлы с диска
            var stored = await db.WorkEntries
                .Where(e => e.TeacherId == selectedTeacherId && e.StoredFileName != null)
                .Select(e => e.StoredFileName!)
                .ToListAsync();
            foreach (var f in stored) Storage.Delete(f);

            // удаляем преподавателя (записи удалятся каскадом)
            var teacher = await db.Teachers.FindAsync(selectedTeacherId);
            if (teacher != null)
            {
                db.Teachers.Remove(teacher);
                await db.SaveChangesAsync();
            }

            teachers.RemoveAll(x => x.Id == selectedTeacherId);
            selectedTeacherId = 0;
            entries = new();
            showDeleteTeacher = false;
        }
        catch (Exception ex)
        {
            deleteError = "Не удалось удалить: " + ex.Message;
        }
        finally
        {
            deleting = false;
        }
    }
    private void OpenAddEntry()
    {
        editingId = 0;
        draftSection = 1;
        draftWorkTypeId = 0;
        draftWorkType = null;
        draftOptionId = 0;
        draftManualPoints = 0;
        draftQuantity = 1;
        draftComment = null;
        draftFile = null;
        draftExistingFileName = null;
        draftExistingStoredName = null;
        draftRemoveFile = false;
        entryError = null;
        showEntry = true;
    }

    private void OpenEditEntry(WorkEntry e)
    {
        editingId = e.Id;
        draftSection = (int)e.WorkType!.Section;
        draftWorkTypeId = e.WorkTypeId;
        draftWorkType = workTypes.FirstOrDefault(w => w.Id == e.WorkTypeId);
        draftOptionId = e.ScoreOptionId ?? 0;
        draftManualPoints = e.WorkType.InputKind == ScoreInputKind.Manual ? e.Points : 0;
        draftQuantity = e.Quantity ?? 1;
        draftComment = e.Comment;
        draftFile = null;
        draftExistingFileName = e.OriginalFileName;
        draftExistingStoredName = e.StoredFileName;
        draftRemoveFile = false;
        entryError = null;
        showEntry = true;
    }

    private void CloseEntry() => showEntry = false;

    private void OnDraftSectionChanged(ChangeEventArgs e)
    {
        draftSection = int.Parse(e.Value?.ToString() ?? "1");
        draftWorkTypeId = 0;
        draftWorkType = null;
        draftOptionId = 0;
    }

    private void OnDraftWorkTypeChanged(ChangeEventArgs e)
    {
        draftWorkTypeId = int.Parse(e.Value?.ToString() ?? "0");
        draftWorkType = workTypes.FirstOrDefault(w => w.Id == draftWorkTypeId);
        draftOptionId = 0;
        if (draftWorkType?.InputKind == ScoreInputKind.Quantity && draftQuantity < 1) draftQuantity = 1;
    }

    private void OnDraftOptionChanged(ChangeEventArgs e) =>
        draftOptionId = int.Parse(e.Value?.ToString() ?? "0");

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        draftFile = e.File;
        draftRemoveFile = false;
    }

    private void RemoveDraftFile()
    {
        draftExistingFileName = null;
        draftRemoveFile = true;
    }

    private decimal ComputeDraftPoints()
    {
        if (draftWorkType == null) return 0;
        return draftWorkType.InputKind switch
        {
            ScoreInputKind.Fixed => draftWorkType.FixedPoints ?? 0,
            ScoreInputKind.Choice => draftWorkType.Options.FirstOrDefault(o => o.Id == draftOptionId)?.Points ?? 0,
            ScoreInputKind.Manual => draftManualPoints,
            ScoreInputKind.Quantity => (draftWorkType.UnitPoints ?? 0) * draftQuantity,
            _ => 0
        };
    }

    private async Task SaveEntry()
    {
        entryError = null;
        if (draftWorkType == null) { entryError = "Выберите вид работы."; return; }
        if (draftWorkType.InputKind == ScoreInputKind.Choice && draftOptionId == 0)
        { entryError = "Выберите вариант баллов."; return; }
        if (draftWorkType.InputKind == ScoreInputKind.Quantity && draftQuantity < 1)
        { entryError = "Укажите количество."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();

        WorkEntry entry;
        if (editingId == 0)
        {
            entry = new WorkEntry
            {
                TeacherId = selectedTeacherId,
                AcademicYear = academicYear,
                Semester = semester,
                CreatedAt = DateTime.UtcNow
            };
            db.WorkEntries.Add(entry);
        }
        else
        {
            entry = await db.WorkEntries.FirstAsync(e => e.Id == editingId);
        }

        entry.WorkTypeId = draftWorkType.Id;
        entry.ScoreOptionId = draftWorkType.InputKind == ScoreInputKind.Choice ? draftOptionId : null;
        entry.Quantity = draftWorkType.InputKind == ScoreInputKind.Quantity ? draftQuantity : null;
        entry.Points = ComputeDraftPoints();
        entry.Comment = string.IsNullOrWhiteSpace(draftComment) ? null : draftComment.Trim();

        // файл
        if (draftRemoveFile && !string.IsNullOrEmpty(draftExistingStoredName))
        {
            Storage.Delete(draftExistingStoredName);
            entry.StoredFileName = null;
            entry.OriginalFileName = null;
        }
        if (draftFile != null)
        {
            if (!string.IsNullOrEmpty(entry.StoredFileName)) Storage.Delete(entry.StoredFileName);
            await using var stream = draftFile.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            entry.StoredFileName = await Storage.SaveAsync(stream, draftFile.Name);
            entry.OriginalFileName = draftFile.Name;
        }

        await db.SaveChangesAsync();
        showEntry = false;
        await LoadEntries();
    }

    private async Task DeleteEntry(WorkEntry e)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var db_e = await db.WorkEntries.FindAsync(e.Id);
        if (db_e != null)
        {
            if (!string.IsNullOrEmpty(db_e.StoredFileName)) Storage.Delete(db_e.StoredFileName);
            db.WorkEntries.Remove(db_e);
            await db.SaveChangesAsync();
        }
        await LoadEntries();
    }

    private decimal SectionRaw(WorkSection sec) =>
        entries.Where(e => e.WorkType!.Section == sec).Sum(e => e.Points);

    private decimal GrandTotal()
    {
        decimal sum = 0;
        foreach (var sec in Enum.GetValues<WorkSection>())
            sum += ScoringRules.CapSection(SectionRaw(sec));
        return ScoringRules.CapTotal(sum);
    }

    private void GoToReport()
    {
        var url = $"report?year={Uri.EscapeDataString(academicYear)}&sem={semester}&dept={SelectedDeptId()}";
        Nav.NavigateTo(url);
    }

    private int SelectedDeptId() =>
        teachers.FirstOrDefault(t => t.Id == selectedTeacherId)?.DepartmentId ?? 0;
}
