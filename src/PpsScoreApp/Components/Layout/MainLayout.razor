@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        @* Обычный HTML-onclick, а не @@onclick: шапка общая для всех страниц, в том числе
           статических (Login), где интерактивность не включена — history.back() работает везде. *@
        <button type="button" class="back-btn" onclick="history.back()" title="Вернуться назад">
            <span class="back-arrow" aria-hidden="true">←</span> Назад
        </button>
        <div class="brand">СГУПС · Учёт баллов ППС</div>
        <AuthorizeView>
            <Authorized>
                <nav>
                    <NavLink href="" Match="NavLinkMatch.All">Ввод показателей</NavLink>
                    <NavLink href="report">Отчёты</NavLink>
                    <AuthorizeView Roles="Admin" Context="adm">
                        <NavLink href="users">Пользователи</NavLink>
                    </AuthorizeView>
                </nav>
                <div class="user-box">
                    <span class="user-name">@context.User.Identity?.Name</span>
                    <form method="post" action="/auth/logout" data-enhance="false">
                        <button class="btn small" type="submit">Выйти</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>
    <main class="app-main">
        <div class="page-wrap">
            @Body
        </div>
    </main>
</div>
